{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun", "@girs/adw-1", "@girs/gdk-4.0", "@girs/gio-2.0", "@girs/glib-2.0", "@girs/gobject-2.0", "@girs/graphene-1.0", "@girs/gtk-4.0", "@girs/javascriptcore-6.0", "@girs/pango-1.0", "@girs/webkit-6.0"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
