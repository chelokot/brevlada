{
    "app-id": "io.github.ExposedCat.Brevlada",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "brevlada",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--share=network",
        "--filesystem=xdg-download/Brevlada:create",
        "--talk-name=org.gnome.OnlineAccounts"
    ],
    "modules": [
        {
            "name": "brevlada",
            "buildsystem": "simple",
            "build-commands": [
                "bun/bun-linux-*/bun build.ts",
                "install -Dm755 dist/brevlada /app/bin/brevlada",
                "install -Dm644 data/io.github.ExposedCat.Brevlada.service /app/share/dbus-1/services/io.github.ExposedCat.Brevlada.service",
                "install -Dm644 data/io.github.ExposedCat.Brevlada.desktop /app/share/applications/io.github.ExposedCat.Brevlada.desktop",
                "install -Dm644 data/io.github.ExposedCat.Brevlada.metainfo.xml /app/share/metainfo/io.github.ExposedCat.Brevlada.metainfo.xml",
                "install -Dm644 resources/brevlada-mail-read-symbolic.svg /app/share/icons/hicolor/scalable/apps/io.github.ExposedCat.Brevlada.svg",
                "install -Dm644 resources/brevlada-mail-read-symbolic.svg /app/share/icons/hicolor/symbolic/apps/io.github.ExposedCat.Brevlada-symbolic.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        "node_modules",
                        "dist",
                        ".flatpak",
                        ".flatpak-builder"
                    ]
                },
                {
                    "type": "archive",
                    "url": "https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-linux-x64.zip",
                    "sha256": "36368faef7527875d5ffa52e53cd48021741f2a83eb6208a8dd64068d422a913",
                    "dest": "bun",
                    "strip-components": 0,
                    "only-arches": ["x86_64"]
                },
                {
                    "type": "archive",
                    "url": "https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-linux-aarch64.zip",
                    "sha256": "54328bbc2d9c8e0c9f892c544d66c57a83b84139e34909e5ee81758f1ac8fda7",
                    "dest": "bun",
                    "strip-components": 0,
                    "only-arches": ["aarch64"]
                }
            ]
        }
    ]
}
